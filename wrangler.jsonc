{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wrongbot-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serves /* that isn't matched by a route below (the landing page) as static assets.
  // run_worker_first: true so every request (including static assets) hits fetch()
  // in src/index.ts first, which is what applies security headers and discovery
  // Link headers uniformly — otherwise Workers Assets serves matching files
  // directly and the Worker never sees the request.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // WrongBot is stateless-ish but McpAgent requires a Durable Object per session.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "WrongBotMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WrongBotMCP"]
    }
  ],

  // wrongbot.jasperkooij.com is on the same Cloudflare account/zone as this
  // Worker, so this is a custom domain, not a separate DNS + hosting setup.
  "routes": [
    { "pattern": "wrongbot.jasperkooij.com", "custom_domain": true }
  ],

  // Per-IP throttle on /mcp and /sse — the only endpoints that spin up a
  // Durable Object. This account is on the Workers Free plan (confirmed by
  // a failed deploy when a `limits.cpu_ms` block was added here — that
  // feature requires Paid). Free plan has no usage-based billing at all:
  // exceeding a free daily quota just errors out until it resets at
  // 00:00 UTC, it doesn't generate a bill. So this rate limit isn't a
  // cost control, it's an availability one — keeping one abusive IP from
  // burning through the shared daily Durable Object quota and taking the
  // whole site down for everyone else until the reset.
  "ratelimits": [
    {
      "name": "MCP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
